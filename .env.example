# Timezone for schedules (morning brief, reminders)
TIMEZONE=Asia/Kolkata

# Where the SQLite database lives (mounted volume in docker-compose)
DATA_DIR=/app/data

# --- Telegram (required for notifications) ---
# Create a bot via @BotFather, then message the bot once and copy your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- MCP capability server (our own tool server) ---
MCP_URL=http://mcp:9000/mcp

# --- Notion (calendar / ideas / knowledge base) ---
# Integration token from https://www.notion.so/my-integrations (NOTION_TOKEN)
NOTION_TOKEN=
# Secret used to secure the local Notion MCP server
NOTION_MCP_AUTH_TOKEN=
NOTION_MCP_URL=http://notion-mcp:3000/mcp

# Parent page IDs under which each needle creates child pages.
# By default all needles share one parent page; point each at its own page
# if you want a separate page per needle.
NOTION_PARENT_GITHUB=3cbddaaf-2318-808d-8a01-000bf855c0b4
NOTION_PARENT_BLOG=3cbddaaf-2318-808d-8a01-000bf855c0b4
NOTION_PARENT_RESEARCH=3cbddaaf-2318-808d-8a01-000bf855c0b4

# --- Jina Reader (info needle / web browsing) ---
# Optional; higher rate limits with a key from https://jina.ai
JINA_API_KEY=

# --- Hugging Face ---
# Optional; enables higher rate limits for model discovery
HF_TOKEN=

# --- GitHub (gh CLI) ---
# Personal access token used by the GitHub needle
GITHUB_TOKEN=

# --- Kaggle ---
# Username + API key from https://www.kaggle.com/settings/account
KAGGLE_USERNAME=
KAGGLE_KEY=

# Morning briefing time, 24h "HH:MM", in TIMEZONE
MORNING_TIME=08:30

# Safety switch for side-effecting tools
ALLOW_SIDE_EFFECTS=false
