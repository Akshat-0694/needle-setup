# Redis inside Docker
REDIS_URL=redis://redis:6379/0

# Persistent event/task database
DB_PATH=/app/data/needle.db

# Optional OpenAI-compatible LLM.
# Leave empty to make researcher run in deterministic fallback mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Security: bind the API to localhost in docker-compose.
# Do not expose port 8000 publicly until authentication is added.
